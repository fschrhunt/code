#!/usr/bin/env bash
# wt — agent worktree control plane.
#
# Canonical repos live in a store (local: ~/.wt after `wt init`; shared: box +
# mount via SSH). Agents get isolated worktrees at
# workspaces/<agent>/<repo>/<city> on branch <agent>/<feature>.
set -uo pipefail

_src=${BASH_SOURCE[0]}
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)
  _src=$(readlink "$_src"); case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac
done
WT_PREFIX=$(cd -P "$(dirname "$_src")/.." >/dev/null 2>&1 && pwd)
WT_LIB="$WT_PREFIX/lib"
WT_VERSION=$(cat "$WT_PREFIX/VERSION" 2>/dev/null || echo "0.0.0")

# shellcheck source=../lib/config.sh
. "$WT_LIB/config.sh"
# shellcheck source=../lib/palette.sh
. "$WT_LIB/palette.sh"
# shellcheck source=../lib/ui.sh
. "$WT_LIB/ui.sh"
# shellcheck source=../lib/agents.sh
. "$WT_LIB/agents.sh"
# shellcheck source=../lib/backend.sh
. "$WT_LIB/backend.sh"
# shellcheck source=../lib/frontend.sh
. "$WT_LIB/frontend.sh"

cmd="${1:-}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  help|-h|--help)       _help; exit 0;;
  version|--version|-v) printf 'wt %s\n' "$WT_VERSION"; exit 0;;
esac

# No args → help (CLI-first; no interactive landing wizard).
[ -z "$cmd" ] && { _help; exit 0; }

if [ "$ON_MAC" = 1 ]; then
  case "$cmd" in
    init)             mac_init "$@";;
    new)              mac_new "$@";;
    rename)           mac_rename "$@";;
    ide|open)         mac_ide "$@";;

    cd)               p=$(mac_cdpath "$@") && printf '__WT_CD__ %s\n' "$p";;
    __cdpath)         mac_cdpath "$@";;
    archive)          mac_archive "$@";;
    restore)          mac_restore "$@";;
    list|ls)          mac_list "$@";;
    archived)         mac_list archived;;   # folded: prefer `wt list archived`
    remove)           mac_remove "$@";;
    doctor)           mac_doctor "$@";;
    config)           mac_config "$@";;
    agents|agent)     mac_agents "$@";;
    update)           mac_update "$@";;
    localdeps)        mac_localdeps "$@";;  # internal; kept for shared SMB
    clone)            mac_clone "$@";;
    sync)             mac_sync "$@";;
    clean)            mac_clean "$@";;
    repos|worktrees)  _bx "$cmd" "$@";;
    status)           mac_doctor "$@";;     # folded into doctor
    *)                die "unknown command: $cmd (try: wt help)";;
  esac
else
  case "$cmd" in
    new) cmd_new "$@";; rename) cmd_rename "$@";; clone) cmd_clone "$@";; delrepo) cmd_delrepo "$@";;
    list|ls) cmd_list "$@";; sync) cmd_sync "$@";; clean) cmd_clean "$@";;
    archive) cmd_archive "$@";; archived) cmd_archived "$@";; restore) cmd_restore "$@";; rmbranch) cmd_rmbranch "$@";;
    remove)
      sub="${1:-}"; shift || true
      case "$sub" in
        branch|rmbranch) cmd_rmbranch "$@";;
        repo|delrepo) cmd_delrepo "$@";;
        *) die "usage: wt remove branch <repo> <branch>
       wt remove repo <repo> [--force]";;
      esac
      ;;
    status) cmd_status "$@";; doctor) cmd_doctor "$@";; repos) cmd_repos "$@";; worktrees) cmd_worktrees "$@";;
    agents|agent)
      sub="${1:-list}"; shift || true
      case "$sub" in
        ""|list|ls) agents_list;;
        add) agents_add "$@";;
        remove|rm) agents_remove "$@";;
        *) die "usage: wt agents [list|add <name>|remove <name>]";;
      esac
      ;;
    init)
      WT_PROFILE_TYPE=local
      mkdir -p "$WT_USER_DIR/repos" "$WT_USER_DIR/workspaces" "$WT_USER_DIR/system/logs"
      if [ -n "${1:-}" ]; then
        agents_add "$1"
      else
        _save_user_config
        ok "local store ready  ${DIM}$WT_USER_DIR${N}"
      fi
      ;;
    *) die "unknown box command: $cmd";;
  esac
fi
