#!/usr/bin/env bash
# Workspaces keeps base repositories in repos/ and task worktrees beneath worktrees/.
set -uo pipefail

_src=${BASH_SOURCE[0]}
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)
  _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac
done
PREFIX=$(cd -P "$(dirname "$_src")/.." >/dev/null 2>&1 && pwd)
VERSION=$(cat "$PREFIX/VERSION" 2>/dev/null || printf '0.0.0')
ROOT_POINTER="${XDG_CONFIG_HOME:-$HOME/.config}/workspaces/root"

_die(){ printf 'error: %s\n' "$*" >&2; exit 1; }
_warn(){ printf 'warning: %s\n' "$*" >&2; }

# Accept only absolute, non-root paths without control characters.
_root_path_ok(){
  case "$1" in ''|'/'|[!/]*) return 1;; *$'\n'*|*$'\r'*) return 1;; esac
  return 0
}

# Select the process override, saved root, or ~/workspaces in that order.
_select_root(){
  if [ -n "${WORKSPACES_ROOT:-}" ]; then
    ROOT=${WORKSPACES_ROOT%/}
    _root_path_ok "$ROOT" || _die "invalid WORKSPACES_ROOT '$ROOT'"
  elif [ -f "$ROOT_POINTER" ]; then
    IFS= read -r ROOT < "$ROOT_POINTER" || ROOT=''
    ROOT=${ROOT%/}
    _root_path_ok "$ROOT" || ROOT="$HOME/workspaces"
  else
    ROOT="$HOME/workspaces"
  fi
  [ -d "$ROOT" ] && ROOT=$(cd -P "$ROOT" >/dev/null 2>&1 && pwd)
}
_select_root

# Create the collection layout and its guide without replacing user content.
_ensure_root(){
  mkdir -p "$ROOT/repos" || _die "could not create $ROOT/repos"
  mkdir -p "$ROOT/worktrees" || _die "could not create $ROOT/worktrees"
  ROOT=$(cd -P "$ROOT" >/dev/null 2>&1 && pwd) || _die "could not resolve $ROOT"
  if [ ! -e "$ROOT/README.md" ]; then
    (set -C; umask 022; command cat "$PREFIX/lib/README.md" > "$ROOT/README.md") 2>/dev/null ||
      [ -e "$ROOT/README.md" ] || _die "could not create $ROOT/README.md"
  fi
}

# Save a custom collection root as a values-only pointer.
_save_root(){
  local dir tmp
  dir=${ROOT_POINTER%/*}
  mkdir -p "$dir" || _die "could not create $dir"
  tmp=$(umask 077; mktemp "$dir/.root.XXXXXX") || _die 'could not create root pointer'
  if ! { printf '%s\n' "$ROOT" > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$ROOT_POINTER"; }; then
    rm -f -- "$tmp"
    _die 'could not save root pointer'
  fi
}

# Repository and task names are single safe path components.
_name_ok(){
  case "$1" in ''|'.'|'..'|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1;; esac
  return 0
}

_repo_path(){
  _name_ok "$1" || _die "invalid repository name '$1'"
  printf '%s/repos/%s' "$ROOT" "$1"
}

# Print normal repository checkouts from the collection's repos directory.
_repositories(){
  local path name
  [ -d "$ROOT/repos" ] || return 0
  for path in "$ROOT/repos"/*; do
    [ -d "$path/.git" ] || continue
    name=${path##*/}
    _name_ok "$name" && printf '%s\n' "$name"
  done
}

# Resolve a linked worktree's private Git directory.
_worktree_git_dir(){ git -C "$1" rev-parse --absolute-git-dir 2>/dev/null; }

# Workspaces ownership is attached to the worktree, so branch and path renames remain safe.
_is_managed_worktree(){
  local git_dir
  git_dir=$(_worktree_git_dir "$1") || return 1
  [ -f "$git_dir/workspaces-managed" ]
}

# Lifecycle paths must be one task directory beneath worktrees/<repo>/.
_is_managed_task(){
  local repo=$1 path=$2 rel
  [ -e "$path/.git" ] || return 1
  case "$path" in "$ROOT/worktrees/$repo"/*) rel=${path#"$ROOT/worktrees/$repo"/};; *) return 1;; esac
  case "$rel" in */*) return 1;; esac
  _is_managed_worktree "$path"
}

# Emit one managed task as repo, path, branch.
_emit_managed_record(){
  local repo=$1 canonical=$2 path=$3 branch=$4
  [ -n "$path" ] && [ "$path" != "$canonical" ] || return 0
  _is_managed_task "$repo" "$path" || return 0
  printf '%s\t%s\t%s\n' "$repo" "$path" "${branch:--}"
}

# Read Git's porcelain records without splitting paths that contain spaces.
_managed_worktrees(){
  local repo canonical line path branch
  for repo in $(_repositories); do
    canonical=$(_repo_path "$repo")
    path=''; branch=''
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        'worktree '*)
          [ -z "$path" ] || _emit_managed_record "$repo" "$canonical" "$path" "$branch"
          path=${line#worktree }; branch=''
          ;;
        'branch refs/heads/'*) branch=${line#branch refs/heads/};;
        '')
          [ -z "$path" ] || _emit_managed_record "$repo" "$canonical" "$path" "$branch"
          path=''; branch=''
          ;;
      esac
    done < <(git -C "$canonical" worktree list --porcelain 2>/dev/null)
    [ -z "$path" ] || _emit_managed_record "$repo" "$canonical" "$path" "$branch"
  done
}

# Find the path currently checking out a local branch.
_branch_worktree(){
  local canonical=$1 wanted=$2 line path=''
  while IFS= read -r line; do
    case "$line" in
      'worktree '*) path=${line#worktree };;
      "branch refs/heads/$wanted") printf '%s' "$path"; return 0;;
    esac
  done < <(git -C "$canonical" worktree list --porcelain 2>/dev/null)
  return 1
}

_help(){
  cat <<'EOF'
Workspaces — ordinary Git repositories with isolated task checkouts.

Start
  workspaces setup [--root <path>]
  workspaces clone <owner/repo | url | path>

Work
  workspaces new <repo> [task]
  workspaces list
  workspaces remove <repo/task | path> [--force]

Inspect
  workspaces root
  workspaces doctor
  workspaces version

Repositories live in ~/workspaces/repos by default. Task worktrees live in
~/workspaces/worktrees/<repo>/<task>. Without a task name, `new` chooses an
unused world capital. `ws` is the short alias for `workspaces`. Workspaces
only removes worktrees it created.
EOF
}

# Initialize the default collection or remember an explicit custom root.
cmd_setup(){
  local requested=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) [ $# -ge 2 ] || _die 'missing value for --root'; requested=$2; shift 2;;
      -h|--help) printf 'usage: workspaces setup [--root <path>]\n'; return 0;;
      *) _die 'usage: workspaces setup [--root <path>]' ;;
    esac
  done
  if [ -n "$requested" ]; then
    requested=${requested%/}
    _root_path_ok "$requested" || _die "invalid root '$requested'"
    ROOT=$requested
  fi
  _root_path_ok "$ROOT" || _die "invalid root '$ROOT'"
  _ensure_root
  [ -z "$requested" ] || _save_root
  printf '%s\n' "$ROOT"
}

# Derive a safe destination name from a Git clone source.
_clone_name(){
  local source=${1%/} name
  source=${source%.git}
  name=${source##*/}
  name=${name##*:}
  printf '%s' "$name"
}

# Clone a normal checkout into the collection's repos directory.
cmd_clone(){
  [ $# -eq 1 ] || _die 'usage: workspaces clone <owner/repo | url | path>'
  local source=$1 url name destination
  if [ -e "$source" ]; then
    url=$source
  else
    case "$source" in
      http://*|https://*|ssh://*|git@*|file://*) url=$source;;
      */*) url="https://github.com/$source.git";;
      *) _die 'pass owner/repo, a Git URL, or a local path';;
    esac
  fi
  name=$(_clone_name "$source")
  _name_ok "$name" || _die "invalid repository name '$name'"
  _ensure_root
  destination="$ROOT/repos/$name"
  [ ! -e "$destination" ] || _die "destination already exists: $destination"
  git clone -- "$url" "$destination" >&2 || _die 'clone failed'
  git -C "$destination" config worktree.useRelativePaths true >/dev/null 2>&1 || true
  printf '%s\n' "$destination"
}

# Pick an unused world capital for an unnamed task.
_random_task(){
  local repo=$1 canonical=$2 count start i candidate
  local capitals=(
    kabul tirana algiers andorra-la-vella luanda saint-johns buenos-aires yerevan
    canberra vienna baku nassau manama dhaka bridgetown minsk brussels belmopan
    porto-novo thimphu sucre sarajevo gaborone brasilia bandar-seri-begawan sofia
    ouagadougou gitega praia phnom-penh yaounde ottawa bangui ndjamena santiago
    beijing bogota moroni brazzaville san-jose yamoussoukro zagreb havana nicosia
    prague kinshasa copenhagen djibouti roseau santo-domingo quito cairo
    san-salvador malabo asmara tallinn mbabane addis-ababa suva helsinki paris
    libreville banjul tbilisi berlin accra athens saint-georges guatemala-city
    conakry bissau georgetown port-au-prince tegucigalpa budapest reykjavik
    new-delhi jakarta tehran baghdad dublin jerusalem rome kingston tokyo amman
    astana nairobi south-tarawa pyongyang seoul kuwait-city bishkek vientiane
    riga beirut maseru monrovia tripoli vaduz vilnius luxembourg antananarivo
    lilongwe kuala-lumpur male bamako valletta majuro nouakchott port-louis
    mexico-city palikir chisinau monaco ulaanbaatar podgorica rabat maputo
    naypyidaw windhoek yaren kathmandu amsterdam wellington managua niamey abuja
    skopje oslo muscat islamabad ngerulmud ramallah panama-city port-moresby
    asuncion lima manila warsaw lisbon doha bucharest moscow kigali basseterre
    castries kingstown apia san-marino sao-tome riyadh dakar belgrade victoria
    freetown singapore bratislava ljubljana honiara mogadishu pretoria juba
    madrid sri-jayawardenepura-kotte khartoum paramaribo stockholm bern damascus
    dushanbe dodoma bangkok dili lome nukualofa port-of-spain tunis ankara
    ashgabat funafuti kampala kyiv abu-dhabi london washington-dc montevideo
    tashkent port-vila vatican-city caracas hanoi sanaa lusaka harare
  )
  count=${#capitals[@]}
  start=$((RANDOM % count))
  for ((i = 0; i < count; i++)); do
    candidate=${capitals[$(((start + i) % count))]}
    if ! git -C "$canonical" show-ref --verify --quiet "refs/heads/$candidate" &&
      [ ! -e "$ROOT/worktrees/$repo/$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  _die "no unused capital names remain for '$repo' — pass an explicit task name"
}

# Create or reattach a task branch beneath worktrees/<repo>/.
cmd_new(){
  if [ $# -lt 1 ] || [ $# -gt 2 ]; then _die 'usage: workspaces new <repo> [task]'; fi
  local repo=$1 task=${2:-} canonical destination active created_branch=0 git_dir
  [ -z "$task" ] || _name_ok "$task" || _die "invalid task name '$task'"
  _ensure_root
  canonical=$(_repo_path "$repo") || exit $?
  [ -d "$canonical/.git" ] || _die "no repository '$repo' — clone it first"
  if [ -z "$task" ]; then task=$(_random_task "$repo" "$canonical") || exit $?; fi
  destination="$ROOT/worktrees/$repo/$task"
  active=$(_branch_worktree "$canonical" "$task" || true)
  if [ -n "$active" ]; then
    if _is_managed_task "$repo" "$active"; then printf '%s\n' "$active"; return 0; fi
    _die "branch '$task' is already checked out outside worktrees/$repo at $active"
  fi
  if [ -e "$destination" ]; then
    local suffix=2
    while [ -e "$destination-$suffix" ]; do suffix=$((suffix + 1)); done
    destination="$destination-$suffix"
  fi
  mkdir -p "$ROOT/worktrees/$repo" || _die "could not create worktrees/$repo"
  git -C "$canonical" config worktree.useRelativePaths true >/dev/null 2>&1 || true
  if git -C "$canonical" show-ref --verify --quiet "refs/heads/$task"; then
    git -C "$canonical" worktree add "$destination" "$task" >/dev/null 2>&1 || _die 'could not create worktree'
  else
    git -C "$canonical" worktree add -b "$task" "$destination" HEAD >/dev/null 2>&1 || _die 'could not create worktree'
    created_branch=1
  fi
  git_dir=$(_worktree_git_dir "$destination") || git_dir=''
  if [ -z "$git_dir" ] || ! printf '1\n' > "$git_dir/workspaces-managed"; then
    git -C "$canonical" worktree remove --force "$destination" >/dev/null 2>&1 || true
    [ "$created_branch" = 0 ] || git -C "$canonical" branch -D "$task" >/dev/null 2>&1 || true
    _die 'could not record worktree ownership'
  fi
  printf '%s\n' "$destination"
}

# Show normal repositories and active managed task worktrees.
cmd_list(){
  [ $# -eq 0 ] || _die 'usage: workspaces list'
  local repo path branch dirty found=0
  printf 'Repositories\n'
  for repo in $(_repositories); do
    path=$(_repo_path "$repo")
    branch=$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null); branch=${branch:-detached}
    dirty=''; [ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ] || dirty=' dirty'
    printf '  %s  %s%s  %s\n' "$repo" "$branch" "$dirty" "$path"
    found=1
  done
  [ "$found" = 1 ] || printf '  (none)\n'
  printf '\nTask worktrees\n'
  found=0
  while IFS=$'\t' read -r repo path branch; do
    [ -n "$path" ] || continue
    dirty=''; [ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ] || dirty=' dirty'
    printf '  %s/%s%s  %s\n' "$repo" "$branch" "$dirty" "$path"
    found=1
  done < <(_managed_worktrees)
  [ "$found" = 1 ] || printf '  (none)\n'
}

# Resolve an exact repo/branch identity or managed worktree path.
_resolve_managed(){
  local selector=$1 candidate=$1 repo path branch matches='' count=0
  if [ -d "$candidate" ]; then candidate=$(cd -P "$candidate" >/dev/null 2>&1 && pwd); fi
  while IFS=$'\t' read -r repo path branch; do
    [ -n "$path" ] || continue
    if [ "$selector" = "$repo/$branch" ] || [ "$candidate" = "$path" ]; then
      matches=$path
      count=$((count + 1))
    fi
  done < <(_managed_worktrees)
  [ "$count" -eq 1 ] && { printf '%s' "$matches"; return 0; }
  [ "$count" -eq 0 ] && _die "no managed worktree matching '$selector'"
  _die "'$selector' matches multiple worktrees; use its path"
}

# Remove only a marked task checkout; retain its branch for ordinary Git use.
cmd_remove(){
  local selector='' force=0 path repo canonical rel task_dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift;;
      -h|--help) printf 'usage: workspaces remove <repo/task | path> [--force]\n'; return 0;;
      *) [ -z "$selector" ] || _die 'usage: workspaces remove <repo/task | path> [--force]'; selector=$1; shift;;
    esac
  done
  [ -n "$selector" ] || _die 'usage: workspaces remove <repo/task | path> [--force]'
  path=$(_resolve_managed "$selector") || exit $?
  case "$path" in "$ROOT/worktrees/"*) rel=${path#"$ROOT/worktrees/"};; *) _die 'refusing to remove a worktree outside worktrees/';; esac
  case "$rel" in */*) task_dir=${rel#*/};; *) _die 'refusing to remove an invalid task path';; esac
  case "$task_dir" in ''|*/*) _die 'refusing to remove an invalid task path';; esac
  if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ] && [ "$force" = 0 ]; then
    printf 'refused: uncommitted changes; commit them or use --force to discard them\n' >&2
    return 3
  fi
  repo=''
  while IFS=$'\t' read -r repo_candidate path_candidate _branch; do
    if [ "$path_candidate" = "$path" ]; then repo=$repo_candidate; break; fi
  done < <(_managed_worktrees)
  [ -n "$repo" ] || _die 'could not identify the owning repository'
  _is_managed_task "$repo" "$path" || _die 'refusing to remove an unmarked worktree'
  canonical=$(_repo_path "$repo")
  if [ "$force" = 1 ]; then
    git -C "$canonical" worktree remove --force "$path" >/dev/null || _die 'could not remove worktree'
  else
    git -C "$canonical" worktree remove "$path" >/dev/null || _die 'could not remove worktree'
  fi
  printf 'removed: %s\n' "$path"
}

# Check the local collection and Git worktree metadata without changing either.
cmd_doctor(){
  [ $# -eq 0 ] || _die 'usage: workspaces doctor'
  local repo canonical status=0
  command -v git >/dev/null 2>&1 || { printf 'error: git is not installed\n'; return 1; }
  printf 'ok: git available\n'
  if [ ! -d "$ROOT" ]; then
    printf 'warning: collection does not exist; run workspaces setup\n'
    return 0
  fi
  printf 'ok: root %s\n' "$ROOT"
  for repo in $(_repositories); do
    canonical=$(_repo_path "$repo")
    if ! git -C "$canonical" fsck --no-dangling >/dev/null 2>&1; then
      printf 'error: repository check failed: %s\n' "$repo"
      status=1
    fi
    if git -C "$canonical" worktree list --porcelain 2>/dev/null | grep -q '^prunable '; then
      printf 'warning: stale worktree metadata: %s\n' "$repo"
    fi
  done
  return "$status"
}

command_name=${1:-help}
[ $# -eq 0 ] || shift
case "$command_name" in
  help|-h|--help) _help;;
  version|-v|--version) printf 'workspaces %s\n' "$VERSION";;
  setup) cmd_setup "$@";;
  clone) cmd_clone "$@";;
  new) cmd_new "$@";;
  list|ls) cmd_list "$@";;
  remove) cmd_remove "$@";;
  root) [ $# -eq 0 ] || _die 'usage: workspaces root'; printf '%s\n' "$ROOT";;
  doctor) cmd_doctor "$@";;
  *) _die "unknown command: $command_name (try: workspaces help)";;
esac
