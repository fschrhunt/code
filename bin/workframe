#!/usr/bin/env bash
# workframe — task worktree control plane.
#
# Canonical repos live in a store (local: selected by `workframe setup`; shared: box +
# mount via SSH). Tasks get isolated worktrees at
# workspaces/<repo>/<city> on the task branch.
#
# User-facing CLI is the frontend (any OS). WORKFRAME_BACKEND=1 selects the store
# verbs used by tests and the SSH box process.
set -uo pipefail

_src=${BASH_SOURCE[0]}
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)
  _src=$(readlink "$_src"); case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac
done
WORKFRAME_PREFIX=$(cd -P "$(dirname "$_src")/.." >/dev/null 2>&1 && pwd)
WORKFRAME_LIB="$WORKFRAME_PREFIX/lib"
WORKFRAME_VERSION=$(cat "$WORKFRAME_PREFIX/VERSION" 2>/dev/null || echo "0.0.0")

# shellcheck source=../lib/config.sh
. "$WORKFRAME_LIB/config.sh"
# shellcheck source=../lib/palette.sh
. "$WORKFRAME_LIB/palette.sh"
# shellcheck source=../lib/ui.sh
. "$WORKFRAME_LIB/ui.sh"
# shellcheck source=../lib/backend.sh
. "$WORKFRAME_LIB/backend.sh"
# shellcheck source=../lib/frontend.sh
. "$WORKFRAME_LIB/frontend.sh"

cmd="${1:-}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  help|-h|--help)
    _help
    exit 0;;
  version|--version|-v) printf 'workframe %s\n' "$WORKFRAME_VERSION"; exit 0;;
esac

if [ "${WORKFRAME_ROOT_SELECTED:-0}" = 1 ] && [ ! -d "$WORKFRAME_USER_DIR" ]; then
  case "$cmd" in
    ""|wizard|setup|init|update) ;;
    *) die "selected Workframe root is unavailable: $WORKFRAME_USER_DIR (attach the volume or run: workframe)";;
  esac
fi

if [ "${WORKFRAME_BACKEND:-0}" = 1 ]; then
  case "$cmd" in
    new) cmd_new "$@";; clone) cmd_clone "$@";;
    list|ls) cmd_list "$@";; archive) cmd_archive "$@";; archived) cmd_archived "$@";;
    restore) cmd_restore "$@";; rmbranch) cmd_rmbranch "$@";; migrate) cmd_migrate "$@";;
    remove)
      [ "${1:-}" = branch ] || die 'usage: workframe remove branch <repo> <task> --yes'
      shift || true; cmd_rmbranch "$@"
      ;;
    status) cmd_status "$@";; doctor) cmd_doctor "$@";; guide) cmd_guide "$@";; repos) cmd_repos "$@";; sync) cmd_sync "$@";; worktrees) cmd_worktrees "$@";;
    setup)
      mkdir -p "$WORKFRAME_USER_DIR/repos" "$WORKFRAME_USER_DIR/workspaces" "$WORKFRAME_USER_DIR/system/logs"
      _ensure_store_guide "$WORKFRAME_USER_DIR" || die "could not create Workframe guide at $WORKFRAME_USER_DIR/WORKFRAME.md"
      _save_user_config || die "could not save Workframe config at $WORKFRAME_USER_CONFIG"
      printf 'initialized: %s\n' "$WORKFRAME_USER_DIR"
      ;;
    *) die "unknown command: $cmd (try: workframe help)";;
  esac
else
  case "$cmd" in
    "")          _help;;
    setup)       mac_setup "$@";;
    clone)       mac_clone "$@";;
    new)         mac_new "$@";;
    list|ls)     mac_list "$@";;
    worktrees)   mac_worktrees "$@";;
    repos)       mac_repos "$@";;
    sync)        mac_sync "$@";;
    update)      mac_update "$@";;
    path)        mac_path "$@";;
    current)     mac_current "$@";;
    run)         mac_run "$@";;
    archive)     mac_archive "$@";;
    restore)     mac_restore "$@";;
    remove)      mac_remove "$@";;
    migrate)     mac_migrate "$@";;
    status)      mac_status "$@";;
    doctor)      mac_doctor "$@";;
    *)                die "unknown command: $cmd (try: workframe help)";;
  esac
fi
