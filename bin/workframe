#!/usr/bin/env bash
# workframe — task worktree control plane.
#
# Canonical repos live in a store (local: selected by `workframe setup`; shared: box +
# mount via SSH). Tasks get isolated worktrees at
# workspaces/<repo>/<city> on the task branch.
#
# User-facing CLI is the frontend (any OS). WORKFRAME_BACKEND=1 selects the store
# verbs used by tests and the SSH box process.
set -uo pipefail

_src=${BASH_SOURCE[0]}
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)
  _src=$(readlink "$_src"); case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac
done
WORKFRAME_PREFIX=$(cd -P "$(dirname "$_src")/.." >/dev/null 2>&1 && pwd)
WORKFRAME_LIB="$WORKFRAME_PREFIX/lib"
WORKFRAME_VERSION=$(cat "$WORKFRAME_PREFIX/VERSION" 2>/dev/null || echo "0.0.0")

# shellcheck source=../lib/config.sh
. "$WORKFRAME_LIB/config.sh"
# shellcheck source=../lib/palette.sh
. "$WORKFRAME_LIB/palette.sh"
# shellcheck source=../lib/ui.sh
. "$WORKFRAME_LIB/ui.sh"
# shellcheck source=../lib/editor.sh
. "$WORKFRAME_LIB/editor.sh"
# shellcheck source=../lib/backend.sh
. "$WORKFRAME_LIB/backend.sh"
# shellcheck source=../lib/frontend.sh
. "$WORKFRAME_LIB/frontend.sh"

cmd="${1:-}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  help|-h|--help)
    _help
    exit 0;;
  version|--version|-v) printf 'workframe %s\n' "$WORKFRAME_VERSION"; exit 0;;
esac

if [ "${WORKFRAME_ROOT_SELECTED:-0}" = 1 ] && [ ! -d "$WORKFRAME_USER_DIR" ]; then
  case "$cmd" in
    ""|wizard|setup|init|update) ;;
    *) die "selected Workframe root is unavailable: $WORKFRAME_USER_DIR (attach the volume or run: workframe)";;
  esac
fi

if [ "${WORKFRAME_BACKEND:-0}" = 1 ]; then
  case "$cmd" in
    new) cmd_new "$@";; rename) cmd_rename "$@";; clone) cmd_clone "$@";; delrepo) cmd_delrepo "$@";;
    list|ls) cmd_list "$@";; sync) cmd_sync "$@";; clean) cmd_clean "$@";;
    archive) cmd_archive "$@";; archived) cmd_archived "$@";; restore) cmd_restore "$@";; rmbranch) cmd_rmbranch "$@";; migrate) cmd_migrate "$@";;
    remove)
      sub="${1:-}"; shift || true
      case "$sub" in
        branch|rmbranch) cmd_rmbranch "$@";;
        repo|delrepo) cmd_delrepo "$@";;
        *) die "usage: workframe remove branch <repo> <branch>
       workframe remove repo <repo> [--force] [--yes]";;
      esac
      ;;
    status) cmd_status "$@";; doctor) cmd_doctor "$@";; guide) cmd_guide "$@";; repos) cmd_repos "$@";; worktrees) cmd_worktrees "$@";;
    setup|init)
      WORKFRAME_PROFILE_TYPE=local
      mkdir -p "$WORKFRAME_USER_DIR/repos" "$WORKFRAME_USER_DIR/workspaces" "$WORKFRAME_USER_DIR/system/logs"
      _ensure_store_guide "$WORKFRAME_USER_DIR" || die "could not create Workframe guide at $WORKFRAME_USER_DIR/WORKFRAME.md"
      _save_user_config || die "could not save Workframe config at $WORKFRAME_USER_CONFIG"
      ok "local store ready  ${DIM}$WORKFRAME_USER_DIR${N}"
      ;;
    *) die "unknown command: $cmd (try: workframe help)";;
  esac
else
  case "$cmd" in
    "")                _help;;
    wizard)             warn "'workframe wizard' was removed; use 'workframe help'"; _help;;
    setup)            mac_setup "$@";;
    init)             mac_init "$@";;
    new)              mac_new "$@";;
    resume)           mac_resume "$@";;
    current)          mac_current "$@";;
    run)              mac_run "$@";;
    dashboard)        mac_dashboard "$@";;
    rename)           mac_rename "$@";;
    ide|open)         mac_ide "$@";;

    # `path` is the stable spelling for scripts and coding agents: the optional
    # shell integration wraps `workframe` in a function that intercepts `cd` and
    # changes directory instead of printing, so `$(workframe cd …)` is empty for
    # anyone who accepted the hook. The function passes every other verb through.
    path)             mac_cdpath "$@";;
    cd)               mac_cdpath "$@";;
    __cdpath)         mac_cdpath "$@";;
    archive)          mac_archive "$@";;
    restore)          mac_restore "$@";;
    list|ls)          mac_list "$@";;
    archived)         mac_list archived;;   # folded: prefer `workframe list archived`
    remove)           mac_remove "$@";;
    doctor)           mac_doctor "$@";;
    config)           mac_config "$@";;
    migrate)           mac_migrate "$@";;
    update)           mac_update "$@";;
    clone)            mac_clone "$@";;
    sync)             mac_sync "$@";;
    clean)            mac_clean "$@";;
    repos)            mac_repos "$@";;
    worktrees)        mac_worktrees "$@";;
    status)           mac_status "$@";;
    completion|completions) mac_completion "$@";;
    *)                die "unknown command: $cmd (try: workframe help)";;
  esac
fi
