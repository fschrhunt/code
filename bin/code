#!/usr/bin/env bash
# Code — a thin wrapper over Git checkouts and worktrees in one folder.
#
# Layout:
#   <root>/repos/<repo>        clones, kept on their default branch
#   <root>/worktrees/<branch>  one branch and one task per worktree
#
# The root defaults to ~/Code and can be overridden with CODE_ROOT.
set -uo pipefail

# Resolve the script's real path so a symlinked install still finds VERSION.
_src=${BASH_SOURCE[0]}
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)
  _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac
done
PREFIX=$(cd -P "$(dirname "$_src")/.." >/dev/null 2>&1 && pwd)
VERSION=$(cat "$PREFIX/VERSION" 2>/dev/null || printf '0.0.0')

_die(){ printf 'error: %s\n' "$*" >&2; exit 1; }

ROOT=${CODE_ROOT:-$HOME/Code}
ROOT=${ROOT%/}
case "$ROOT" in
  ''|'/'|[!/]*) _die 'CODE_ROOT must be an absolute path';;
  *$'\n'*|*$'\r'*) _die 'CODE_ROOT must not contain newlines';;
esac

# A repository name is one safe path component.
_name_ok(){
  case "$1" in
    ''|'.'|'..'|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1;;
  esac
  return 0
}

_repo_dir(){ printf '%s/repos/%s' "$ROOT" "$1"; }

# Identify the base checkout containing the current directory.
_current_repository(){
  local top repo
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  top=$(cd -P "$top" >/dev/null 2>&1 && pwd) || return 1
  case "$top" in "$ROOT/repos/"*) repo=${top#"$ROOT/repos/"};; *) return 1;; esac
  case "$repo" in ''|*/*) return 1;; esac
  _name_ok "$repo" || return 1
  [ -d "$top/.git" ] || return 1
  printf '%s' "$repo"
}

# Flatten a branch into a folder name: feat/thing -> feat-thing.
_branch_folder(){
  local name
  name=$(printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-')
  while :; do
    case "$name" in
      [-.]*) name=${name#?};;
      *[-.]) name=${name%?};;
      *) break;;
    esac
  done
  case "$name" in ''|'.'|'..') return 1;; esac
  printf '%s' "$name"
}

# Derive a repository name from a clone source.
_clone_name(){
  local source=${1%/} name
  source=${source%.git}
  name=${source##*/}
  name=${name##*:}
  printf '%s' "$name"
}

_help(){
  cat <<'EOF'
Code — Git checkouts and worktrees in one folder.

Usage
  code clone <owner/repo | url | path>
  code new <branch>
  code list
  code remove <name | path> [--force]
  code root
  code upgrade
  code version
  code help

Repositories are cloned to <root>/repos/<repo>. Run `new` inside one to create
<root>/worktrees/<branch> on branch <branch>. The root defaults to ~/Code; set
CODE_ROOT to use another folder.
EOF
}

# Clone a repository into repos/.
cmd_clone(){
  [ $# -eq 1 ] || _die 'usage: code clone <owner/repo | url | path>'
  local source=$1 url name destination
  if [ -e "$source" ]; then
    url=$source
  else
    case "$source" in
      http://*|https://*|ssh://*|git@*|file://*) url=$source;;
      */*) url="https://github.com/$source.git";;
      *) _die 'pass owner/repo, a Git URL, or a local path';;
    esac
  fi
  name=$(_clone_name "$source")
  _name_ok "$name" || _die "invalid repository name '$name'"
  mkdir -p "$ROOT/repos" || _die "could not create $ROOT/repos"
  destination="$ROOT/repos/$name"
  [ ! -e "$destination" ] || _die "destination already exists: $destination"
  git clone -- "$url" "$destination" >&2 || _die 'clone failed'
  printf '%s\n' "$destination"
}

# Create worktrees/<branch> from the base checkout containing the current
# directory. An existing local branch is checked out; otherwise it is created
# at the base checkout's current HEAD.
cmd_new(){
  [ $# -eq 1 ] || _die 'usage: code new <branch>'
  local branch=$1 repo canonical folder destination
  case "$branch" in
    '') _die 'branch name is required';;
    *$'\n'*|*$'\r'*) _die 'branch name must not contain newlines';;
  esac
  repo=$(_current_repository) || _die "run from a base checkout under $ROOT/repos/<repo>"
  canonical=$(_repo_dir "$repo")
  [ -d "$canonical/.git" ] || _die "no repository '$repo'"
  folder=$(_branch_folder "$branch") || _die "cannot derive a folder from branch '$branch'"
  destination="$ROOT/worktrees/$folder"
  [ ! -e "$destination" ] || _die "worktree already exists: $destination"
  mkdir -p "$ROOT/worktrees" || _die "could not create $ROOT/worktrees"
  if git -C "$canonical" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$canonical" worktree add "$destination" "$branch" >&2 || _die 'could not create worktree'
  else
    git -C "$canonical" worktree add -b "$branch" "$destination" HEAD >&2 || _die 'could not create worktree'
  fi
  printf '%s\n' "$destination"
}

# List base checkouts and their worktrees beneath worktrees/.
cmd_list(){
  [ $# -eq 0 ] || _die 'usage: code list'
  local canonical repo branch path line found=0
  printf 'Repositories\n'
  for canonical in "$ROOT"/repos/*; do
    [ -d "$canonical/.git" ] || continue
    repo=${canonical##*/}
    branch=$(git -C "$canonical" symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=detached
    printf '  %s  %s  %s\n' "$repo" "$branch" "$canonical"
    found=1
  done
  [ "$found" = 1 ] || printf '  (none)\n'
  printf '\nWorktrees\n'
  found=0
  for canonical in "$ROOT"/repos/*; do
    [ -d "$canonical/.git" ] || continue
    repo=${canonical##*/}
    path=''
    branch=''
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        'worktree '*) path=${line#worktree }; branch='';;
        'branch refs/heads/'*) branch=${line#branch refs/heads/};;
        '')
          case "$path" in
            "$ROOT/worktrees/"*)
              printf '  %s/%s  %s\n' "$repo" "${branch:-${path##*/}}" "$path"
              found=1
              ;;
          esac
          path=''
          branch=''
          ;;
      esac
    done < <(git -C "$canonical" worktree list --porcelain 2>/dev/null)
    case "$path" in
      "$ROOT/worktrees/"*)
        printf '  %s/%s  %s\n' "$repo" "${branch:-${path##*/}}" "$path"
        found=1
        ;;
    esac
  done
  [ "$found" = 1 ] || printf '  (none)\n'
}

# Remove a worktree under worktrees/; the branch is kept.
cmd_remove(){
  local selector='' force=0 path common canonical
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift;;
      -h|--help) printf 'usage: code remove <name | path> [--force]\n'; return 0;;
      *) [ -z "$selector" ] || _die 'usage: code remove <name | path> [--force]'; selector=$1; shift;;
    esac
  done
  [ -n "$selector" ] || _die 'usage: code remove <name | path> [--force]'
  case "$selector" in
    /*) path=$selector;;
    *) path="$ROOT/worktrees/$selector";;
  esac
  case "$path" in
    "$ROOT/worktrees/"*) ;;
    *) _die 'refusing to remove a worktree outside the worktrees folder';;
  esac
  [ -e "$path/.git" ] || _die "no worktree at $path"
  common=$(git -C "$path" rev-parse --git-common-dir 2>/dev/null) || _die "not a Git worktree: $path"
  case "$common" in /*) ;; *) common="$path/$common";; esac
  common=$(cd -P "$common" >/dev/null 2>&1 && pwd) || _die "cannot resolve the Git directory for $path"
  canonical=${common%/.git}
  if [ "$force" = 1 ]; then
    git -C "$canonical" worktree remove --force "$path" >&2 || _die 'could not remove worktree'
  else
    git -C "$canonical" worktree remove "$path" >&2 || _die 'could not remove worktree'
  fi
  printf 'removed: %s\n' "$path"
}

# Update Code itself: pull a checkout install, else re-run the release installer.
cmd_upgrade(){
  [ $# -eq 0 ] || _die 'usage: code upgrade'
  if [ -d "$PREFIX/.git" ]; then
    git -C "$PREFIX" pull --ff-only
  else
    command -v curl >/dev/null 2>&1 || _die 'curl is required to upgrade'
    curl -fsSL https://raw.githubusercontent.com/fschrhunt/code/main/scripts/install.sh | sh
  fi
}

command_name=${1:-help}
[ $# -eq 0 ] || shift
case "$command_name" in
  help|-h|--help) _help;;
  version|-v|--version) printf 'code %s\n' "$VERSION";;
  clone) cmd_clone "$@";;
  new) cmd_new "$@";;
  list|ls) cmd_list "$@";;
  remove|rm) cmd_remove "$@";;
  root) [ $# -eq 0 ] || _die 'usage: code root'; printf '%s\n' "$ROOT";;
  upgrade) cmd_upgrade "$@";;
  *) _die "unknown command: $command_name (try: code help)";;
esac
