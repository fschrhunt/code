#compdef code

_code() {
  local -a commands
  commands=(
    'new:create a worktree on a new branch'
    'list:list repositories and worktrees'
    'remove:remove a worktree'
    'root:print the Code root'
    'upgrade:update Code itself'
    'version:print the installed version'
    'help:show command help'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'code command' commands
    return
  fi
  case $words[2] in
    remove) _arguments '--force[discard uncommitted changes]' ;;
  esac
}

_code "$@"
