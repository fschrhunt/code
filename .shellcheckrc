# wt shellcheck config.
#
# Follow `source`d modules (bin/wt sources lib/*.sh) so the program is analyzed
# as a whole rather than file-by-file (avoids false "unassigned/unused" across
# modules).
external-sources=true
# Resolve `# shellcheck source=../lib/*.sh` directives relative to bin/wt's dir.
source-path=SCRIPTDIR

# Intentional word-splitting on space-separated lists (CACHE_DIRS, agents, and
# newline lists of repo names) is pervasive in this list-oriented CLI.
disable=SC2206,SC2046,SC2086
# bin/wt dispatch: `[ $# -gt 0 ] && shift || true` — intentional; shift must not
# fail the script when invoked with no args (see AGENTS.md).
disable=SC2015
